{
  "name": "planify",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"pnpm --filter @planify/web dev\" \"pnpm --filter @planify/api dev\"",
    "dev:web": "pnpm --filter @planify/web dev",
    "dev:api": "pnpm --filter @planify/api dev",
    "build": "pnpm --filter @planify/web build",
    "start": "pnpm --filter @planify/web start",
    "lint": "pnpm --filter @planify/web lint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p packages/schemas --noEmit && tsc -p packages/types --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5"
  }
}
